# Whitelist: only code, tests, final (v6) results, manuscript sources and documentation are published.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CITATION.cff
!/src/
!/tests/
!/manuscript/
/manuscript/*_archive.md
/manuscript/manuscript.html
!/data/
/data/*
!/data/README.md
!/results/
/results/*
!/results/f1_v6_*
!/results/f1_dev6_lam.csv
!/results/run_v6.sh
!/results/v6_summary.txt
!/docs/
/docs/*
!/docs/f1_final_config.md
/src/download_data.py
/src/more_areas/
/src/f1/figures5.py
/manuscript/latex/Definitions/template_mdpi_orig.tex
__pycache__/
*.pyc
/manuscript/latex/*.aux
/manuscript/latex/*.log
/manuscript/latex/*.out
/manuscript/latex/*.bbl
/manuscript/latex/*.blg
/manuscript/latex/*-eps-converted-to.pdf
